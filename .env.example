# Copy to .env.local. All values are server-only; do not use NEXT_PUBLIC_.
SOLAR_API_KEY=
SOLAR_MODEL=solar-mini4
SOLAR_ENABLED=false
SOLAR_API_ENDS_AT=2026-10-24T11:30:00+09:00
SOLAR_MAX_REQUESTS_PER_MINUTE=30
SOLAR_MAX_REQUESTS_PER_DAY=200
SOLAR_BUDGET_SCOPE=family-2026-10-24

# Production requires a shared counter. Development can use in-memory counters.
# These store only counts, never family input or AI responses.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
